# Sistema de Draft — configuração local
# Copie este arquivo para .env.local e substitua os valores.
# Supabase Dashboard > Project Settings > Data API / API Keys.
#
# Use somente chave pública (publishable/anon).
# NUNCA coloque a chave secret/service_role no código do navegador.
VITE_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
