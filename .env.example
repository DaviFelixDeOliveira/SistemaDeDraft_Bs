# ============================================================
# Variáveis de Ambiente — TBK Hub (Sistema de Draft Brawl Stars)
# ============================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite .env.local no repositório.
#
# No painel da Vercel (Settings > Environment Variables),
# cadastre exatamente estas duas variáveis:
# ============================================================

# URL do projeto Supabase (encontrada em: Settings > API > Project URL)
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"

# Chave anon/public do Supabase (encontrada em: Settings > API > Project API Keys)
# É segura para expor no frontend — o RLS do Supabase controla o acesso.
VITE_SUPABASE_ANON_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXX"
